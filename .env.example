# Google Gemini API Key for AI report and recipe generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: DuckDB resource settings
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4
DUCKDB_TEMP_DIRECTORY=/tmp/duckdb

# Storage Retention & Automated TTL Cleanup Policy
STORAGE_TTL_HOURS=24
STORAGE_CLEANUP_INTERVAL_MINUTES=30
STORAGE_CLEANUP_ENABLED=true
STORAGE_MAX_DISK_PERCENT=90

# Security & Production Hardening
ENVIRONMENT=development
ADMIN_API_KEY=change_me_for_production_maintenance
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
ALLOW_SERVER_CONNECTOR_ENV_CREDS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://datamorph.duckdns.org
MAX_UPLOAD_MB=5120
RATE_LIMIT_ENABLED=true
